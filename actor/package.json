{
	"name": "trippilot-actor",
	"version": "0.0.1",
	"type": "module",
	"description": "TripPilot is an AI-powered travel research Actor that turns natural-language trip requirements into constraint-aware, explainable travel recommendations.",
	"engines": {
		"node": ">=22"
	},
	"dependencies": {
		"@crawlee/cheerio": "^3.15.3",
		"apify": "^3.7.0",
		"dotenv": "^18.0.3",
		"groq-sdk": "^1.6.0"
	},
	"devDependencies": {
		"@apify/eslint-config": "^2.0.0",
		"eslint": "^9.29.0",
		"eslint-config-prettier": "^10.1.5",
		"prettier": "^3.5.3",
		"vitest": "^5.0.0"
	},
	"scripts": {
		"start": "node ./src/main.js",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint",
		"lint:fix": "eslint --fix",
		"test": "vitest run"
	},
	"author": "TripPilot",
	"license": "ISC"
}
